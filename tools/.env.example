# Copy to tools/.env (gitignored) or set these as environment variables. See tools/paths.py.
# The coaching folder. Default: the folder above tools/.
SHOTOKAN_HOME=D:\SF6-Claude-Coaching
# Optional overrides
# SHOTOKAN_REPLAYS=D:\SF6-Claude-Coaching\replays
# SHOTOKAN_DB=D:\SF6-Claude-Coaching\history\sf6.db
# SHOTOKAN_CAPTURE_DIRS=D:\SF6-Claude-Coaching\Juniper;E:\old-captures
# SHOTOKAN_RANKED_DIR=D:\SF6-Claude-Coaching\ranked
# Move names from the mods repo (data/sf6_moves)
# SF6_MOVES=C:\Program Files (x86)\Steam\steamapps\common\Street Fighter 6\reframework\data\sf6_moves
# The player in focus. Default: player_name / cfn_id in $SHOTOKAN_HOME\shotokan.json
# SHOTOKAN_PLAYER=.shog
# SHOTOKAN_CFN_ID=1307078698
