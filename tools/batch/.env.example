# Copy to .env and fill in. Keep .env private; the script never prints the password.
OBS_HOST=localhost
OBS_PORT=4455
OBS_PASSWORD=
# reframework\data folder inside your SF6 install
REFRAMEWORK_DATA=C:\Program Files (x86)\Steam\steamapps\common\Street Fighter 6\reframework\data
# Your coaching folder; captures and videos go to its replays\ folder (or set SHOTOKAN_REPLAYS to put them elsewhere).
# REPLAYS_DIR still works as an older name for SHOTOKAN_REPLAYS.
SHOTOKAN_HOME=D:\SF6-Claude-Coaching
# Buckler (buckler_replays.py): the Cookie header from your own logged-in streetfighter.com/6/buckler tab. Keep it private; the script never prints it.
BUCKLER_COOKIE=
